FROM node:22-alpine
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY server.mjs telegram-auth.mjs rooms.mjs match-flow.mjs match-board.mjs game-emojis.mjs special-rules.mjs match-watch.mjs classic-rules.mjs admin-results.mjs tron-deposits.mjs shared-wallet.mjs bot-admin.mjs bot-operations.mjs test-bot-operations.mjs fee-policy.mjs settlement-journal.mjs readiness.mjs money-engine.mjs wallet-ops.mjs test-wallet-ops.mjs test-money-engine.mjs test-paid-flow.mjs test-stake-input.mjs test-readiness.mjs test-settlement-journal.mjs test-fee-policy.mjs test-bot-admin.mjs test-shared-wallet.mjs test-tron-deposits.mjs test-admin-results.mjs test-classic.mjs test-watch.mjs test-flow.mjs test-board.mjs test-games.mjs test-special.mjs test-result-notices.mjs ./
ENV NODE_ENV=production
EXPOSE 3000
RUN node --check server.mjs && node --check telegram-auth.mjs && node --check rooms.mjs && node --check match-flow.mjs && node --check match-board.mjs && node --check game-emojis.mjs && node --check special-rules.mjs && node --check match-watch.mjs && node --check classic-rules.mjs && node --check admin-results.mjs && node --check tron-deposits.mjs && node --check shared-wallet.mjs && node --check bot-admin.mjs && node --check bot-operations.mjs && node test-bot-operations.mjs && node --check fee-policy.mjs && node --check settlement-journal.mjs && node --check readiness.mjs && node --check money-engine.mjs && node --check wallet-ops.mjs && node test-wallet-ops.mjs && node test-money-engine.mjs && node test-paid-flow.mjs && node test-stake-input.mjs && node test-readiness.mjs && node test-settlement-journal.mjs && node test-fee-policy.mjs && node test-bot-admin.mjs && node test-shared-wallet.mjs && node test-tron-deposits.mjs && node test-admin-results.mjs && node test-classic.mjs && node test-watch.mjs && node test-flow.mjs && node test-board.mjs && node test-games.mjs && node test-special.mjs && node test-result-notices.mjs
CMD ["node","server.mjs"]
